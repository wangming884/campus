# 服务端口
PORT=5624

# 数据库：优先 MySQL；设为 true 则直接使用本地 SQLite（需 Node >= 22.5）
USE_SQLITE=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=campus_club

# 必填：JWT 签名密钥，至少 32 位随机字符串
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 首次初始化超管时的初始密码；留空则随机生成并打印一次
ADMIN_INITIAL_PASSWORD=

# 已审核申请的附件保留天数（<=0 表示不自动清理）
ATTACHMENT_RETENTION_DAYS=30

# 部署在 Nginx / 负载均衡之后时填写跳数（如 1），否则留空
TRUST_PROXY=

# 需要跨域时填写逗号分隔的来源白名单，例如 https://club.example.com
CORS_ORIGINS=

# 仅当站点全站启用 HTTPS 时设为 true
COOKIE_SECURE=false

# 可选：自定义 LibreOffice 可执行文件路径
LIBREOFFICE_PATH=
